{
  "rules": {
    ".read": false,
    ".write": false,
    "catalog": {
      ".read": true
    },
    "settings": {
      ".read": true
    },
    "orders": {
      ".read": "auth != null && auth.token.admin === true",
      ".indexOn": ["businessDate", "createdAt"]
    },
    "meta": {
      ".read": "auth != null && auth.token.admin === true"
    },
    "reports": {
      ".read": "auth != null && auth.token.admin === true"
    }
  }
}
