# =====================================================================
# SR Burguer: variáveis de ambiente
# Copie para .env (local) e cadastre as mesmas chaves na Vercel
# (Project Settings > Environment Variables). Nunca versione o .env.
# =====================================================================

# --- Site -------------------------------------------------------------
# URL pública definitiva (domínio próprio, com https e sem barra no fim).
# Usada em URLs canônicas, sitemap, Open Graph e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://srburguer.vercel.app

# Código de verificação do Google Search Console (só o valor do content da meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Firebase (cliente / navegador) ------------------------------------
# Console do Firebase > Configurações do projeto > Seus apps > App da Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (servidor) ----------------------------------------
# Console do Firebase > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada. Use UMA das opções abaixo.
#
# Opção A: campos separados. A chave privada vai entre aspas, com \n literais.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
#
# Opção B: o JSON inteiro da conta de serviço codificado em base64.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("conta.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Painel administrativo --------------------------------------------
# E-mail de acesso ao /admin.
ADMIN_EMAIL=admin@srburger.com.br
# Hash scrypt da senha. Gere com: yarn admin:hash "sua-senha"
ADMIN_PASSWORD_HASH=

# Segredo para assinar a sessão e o CAPTCHA (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Vercel Cron ------------------------------------------------------
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" ao chamar /api/cron/reset.
CRON_SECRET=

# --- Desenvolvimento --------------------------------------------------
# firebase | local. Vazio = automático (Firebase se configurado; senão banco
# local em .data/db.json, apenas fora de produção).
DATA_DRIVER=
